# -----------------------------------------------------------------------------
# EcoSentinel AI — Backend environment variables
# Copy to .env and fill values. Never commit .env.
# -----------------------------------------------------------------------------

# --- Server ---
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL 16) ---
# Local docker:  postgresql://ecosentinel:ecosentinel@localhost:5432/ecosentinel?schema=public
# Neon (managed): postgresql://<user>:<pass>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql://ecosentinel:ecosentinel@localhost:5432/ecosentinel?schema=public

# --- Auth (JWT) ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- File storage (Cloudinary) ---
# Leave blank to run without Cloudinary (image uploads disabled gracefully).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ecosentinel/reports

# --- Real-time (MQTT / ESP32) ---
MQTT_ENABLED=false
MQTT_URL=mqtt://localhost:1883

# --- Background jobs (external API ingestion) ---
ENABLE_JOBS=false
JOB_CRON_WEATHER=*/30 * * * *
JOB_CRON_AIR_QUALITY=*/30 * * * *
JOB_CRON_EARTHQUAKE=*/5 * * * *
JOB_CRON_FIRE=*/60 * * * *

# --- External API keys (all optional; jobs disabled by default) ---
OPENWEATHER_API_KEY=
FIRMS_API_KEY=
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# --- Seed default users ---
SEED_ADMIN_EMAIL=admin@ecosentinel.in
SEED_ADMIN_PASSWORD=Admin@1234
SEED_AUTHORITY_EMAIL=authority@ecosentinel.in
SEED_AUTHORITY_PASSWORD=Authority@1234
SEED_CITIZEN_EMAIL=citizen@ecosentinel.in
SEED_CITIZEN_PASSWORD=Citizen@1234